# Strapi バックエンドの URL
# ローカル開発時: http://localhost:1337
# STG / 本番: Strapi Cloud のエンドポイント URL に変更する
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Strapi API トークン（本番環境では必ず設定する）
# 設定方法: Strapi 管理画面 → Settings → API Tokens → Create new API token
# STRAPI_API_TOKEN=your_api_token_here

# お問い合わせフォーム（/contact）のメール送信
# プロバイダ: ses | resend | log（未指定なら認証情報から推定。開発環境はどれもなければ log、本番はエラー）
# CONTACT_MAIL_PROVIDER=ses
#
# --- SES（推奨）---
# 開発中は開発者アカウントの送信専用 IAM ユーザー、リリース前に運営者アカウントの値へ差し替える。
# 開発者アカウントはサンドボックスのため、差出人・宛先ともに SES で検証済みのアドレスにする
# AWS_SES_REGION=ap-northeast-1
# AWS_SES_ACCESS_KEY_ID=
# AWS_SES_SECRET_ACCESS_KEY=
#
# --- Resend（代替）---
# RESEND_API_KEY=re_xxxxxxxxx
#
# 差出人（SES / Resend で検証済みのアドレス。既定: FlexQ Contact <noreply@flexqstudio.com>）
# CONTACT_FROM_EMAIL="FlexQ Contact <noreply@flexqstudio.com>"
# 運営者宛の受信先を上書き（サンドボックスでのテスト用。既定: contact@flexqstudio.com）
# CONTACT_TO_EMAIL=
# お問い合わせ台帳（Notion「FlexQ お問い合わせ管理 > お問い合わせ一覧」）
# コネクト（app.notion.com/developers/connections・認証方法は API トークン）のトークン。
# コネクトの「コンテンツへのアクセス」で台帳ページを許可しておく。実際の値は .env.local にだけ書くこと
# 未設定なら台帳には書かずメールだけ送る
# NOTION_TOKEN=ntn_xxxxxxxxx
# NOTION_CONTACT_DATA_SOURCE_ID=4a2abac5-74d1-42d8-88eb-cc915ab70f0f
# スパム対策トークンの署名キー（本番では必ず設定する。`openssl rand -hex 32` などで生成）
# 未設定でもフォームは動くが、開発用の固定値で署名するためトークンを偽造できてしまう
# CONTACT_FORM_SECRET=
